# Copy to `deploy/.env` and fill in. `.env` is gitignored; this file is the
# contract and carries no real value.
#
# Every variable the application reads is listed here, including the two that
# must stay unset. That is deliberate: a contract that names only what to set
# cannot tell you what not to.

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------

# The container's superuser, used once to create the owner and app roles and
# never by the application.
DASHER_PG_SUPERUSER=dasher_admin
DASHER_PG_SUPERUSER_PASSWORD=

# The SCHEMA OWNER, for `docker compose run --rm migrate` only. The migrator
# checks it owns the schema before it mutates a role or a table.
DASHER_MIGRATE_DSN=postgresql://dasher_owner:PASSWORD@postgres:5432/dasher

# The APPLICATION's connection, and the only one the web container gets. This
# role cannot write `organizations`, `users`, or `memberships` — that is the
# schema working, not a misconfiguration, and it is why the bootstrap needs a
# different connection string it will not be given here.
DASHER_DATABASE_URL=postgresql://dasher_web_app:PASSWORD@postgres:5432/dasher

# ---------------------------------------------------------------------------
# The deployment
# ---------------------------------------------------------------------------

# The DNS name pointing at this instance. Caddy obtains a certificate for it,
# and the session cookie's `__Host-` prefix and `secure` attribute mean a
# browser will not hold a session without one.
DASHER_PUBLIC_HOSTNAME=

# Recorded on every dashboard version and every audit event, so a row can be
# traced to the code that wrote it. Use the deployed commit SHA.
DASHER_DEPLOYMENT_REVISION=

# `fixture` or `live`. Defaults to `fixture`. Turning this to `live` makes the
# river and air-quality paths call their upstreams on a cache miss.
DASHER_SOURCE_MODE=fixture

# Only read when DASHER_SOURCE_MODE=live, and only by the air-quality source.
OPENAQ_API_KEY=

# ---------------------------------------------------------------------------
# MUST STAY UNSET
# ---------------------------------------------------------------------------
#
# DASHER_DEV_BOOTSTRAP
#   Set to `1`, `POST /dev/bootstrap` mints an authenticated session for anyone
#   who can reach the URL. It is default-off and the route 404s without it —
#   including on GET, so a switched-off deployment does not confirm the route
#   exists. Do not set it on anything reachable from the internet. It is how the
#   end-to-end suite signs in, and that suite runs against a local build.
#
# DASHER_DEV_SEED_DSN
#   A schema-owner connection string, used only by that bootstrap. A production
#   deployment simply does not configure it, which is why seeding needs no grant
#   to the application role.
