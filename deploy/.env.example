# Copy to `deploy/.env` and fill in. `.env` is gitignored; this file is the
# contract and carries no real value.
#
# Every variable the application reads is listed here, including the two that
# must stay unset. That is deliberate: a contract that names only what to set
# cannot tell you what not to.

# ---------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------

# The container's superuser, used once to create the owner and app roles and
# never by the application.
DASHER_PG_SUPERUSER=dasher_admin
DASHER_PG_SUPERUSER_PASSWORD=

# The DATABASE OWNER, for `docker compose run --rm migrate` only. The migrator
# refuses to run as anything else, comparing CURRENT_USER against
# pg_database.datdba — it does not check schema ownership, and could not, since
# it creates the `dasher` schema itself. It needs CREATEROLE too: it runs
# CREATE ROLE dasher_app before applying any migration.
DASHER_MIGRATE_DSN=postgresql://dasher_owner:PASSWORD@postgres:5432/dasher

# The APPLICATION's connection, and the only one the web container gets. This
# role cannot write `organizations`, `users`, or `memberships` — that is the
# schema working, not a misconfiguration, and it is why the bootstrap needs a
# different connection string it will not be given here.
DASHER_DATABASE_URL=postgresql://dasher_web_app:PASSWORD@postgres:5432/dasher

# ---------------------------------------------------------------------------
# The deployment
# ---------------------------------------------------------------------------

# The DNS name pointing at this instance. Caddy obtains a certificate for it,
# and the session cookie's `__Host-` prefix and `secure` attribute mean a
# browser will not hold a session without one.
DASHER_PUBLIC_HOSTNAME=

# Recorded on every dashboard version and every audit event, so a row can be
# traced to the code that wrote it. Use the deployed commit SHA.
DASHER_DEPLOYMENT_REVISION=

# ---------------------------------------------------------------------------
# The planner
# ---------------------------------------------------------------------------

# `fake` (deterministic, no network), `anthropic`, or `openrouter`. An explicit
# choice: a model provider with no matching key fails rather than falling back.
DASHER_PLANNER=fake
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Blank selects the provider-specific default: Claude Opus 5 for Anthropic,
# GLM 5.3 for OpenRouter.
DASHER_PLANNER_MODEL=
DASHER_PLANNER_REASONING_EFFORT=low
DASHER_PLANNER_DAILY_LIMIT=500

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# Where sign-in links point. Taken from configuration and never from the
# request's Host header, which is the classic route to mailing a valid token to
# somebody else's domain. Must be https (browsers make an exception only for
# localhost) because the session cookie is `__Host-` prefixed and Secure.
DASHER_PUBLIC_ORIGIN=https://

# The mail transport, CHOSEN BY NAME. A missing provider means sign-in is
# unavailable — deliberately, rather than falling back to printing links.
#   ses     -> AWS SES through the EC2 instance role; requires AWS_REGION
#   resend  -> Resend using both variables below
#   unset   -> backwards-compatible Resend when both variables are set
#   log     -> print the link to stdout. LOCAL DEVELOPMENT ONLY.
DASHER_MAIL_TRANSPORT=

# Both are required together for the provider path; either alone is treated as
# not configured.
DASHER_RESEND_API_KEY=
DASHER_MAIL_FROM=

# ---------------------------------------------------------------------------
# MUST STAY UNSET
# ---------------------------------------------------------------------------
#
# DASHER_DEV_BOOTSTRAP
#   Set to `1`, `POST /dev/bootstrap` mints an authenticated session for anyone
#   who can reach the URL. It is default-off and the route 404s without it —
#   including on GET, so a switched-off deployment does not confirm the route
#   exists. Do not set it on anything reachable from the internet. It is how the
#   end-to-end suite signs in, and that suite runs against a local build.
#
# DASHER_DEV_SEED_DSN
#   A schema-owner connection string, used only by that bootstrap. A production
#   deployment simply does not configure it, which is why seeding needs no grant
#   to the application role.

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# Where dumps go. Off this instance, because the failure a backup exists for is
# losing the volume — and `source_snapshots` holds uploaded files under an
# immutability trigger, so that volume is the only copy of evidence that live
# dashboards are still citing.
DASHER_BACKUP_S3_URI=s3://your-bucket/dasher

# Seconds between runs. Daily by default.
DASHER_BACKUP_INTERVAL_SECONDS=86400

# Used by both SES and backups. Prefer an EC2 instance role over keys; leave the
# key variables unset when the instance profile provides credentials. The
# backup container reads every row, so a key here is a key to the whole database.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
