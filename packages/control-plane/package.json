{
  "name": "@dasher/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./email": "./src/email.ts",
    "./migrator": "./src/migrator.ts",
    "./preflight": "./src/preflight.ts",
    "./secrets": "./src/secrets.ts",
    "./session-cookie": "./src/session-cookie.ts",
    "./verified-principal": "./src/verified-principal.ts",
    "./schema-snapshot": "./src/schema-snapshot.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/*.integration.test.ts'",
    "test:postgres": "vitest run test/postgres.integration.test.ts test/schema-snapshot.integration.test.ts test/accepted-invalid-states.integration.test.ts test/unprivileged-owner.integration.test.ts test/request-context.integration.test.ts test/dashboard-repository.integration.test.ts --no-file-parallelism",
    "migrate": "vite-node src/migrate-cli.ts"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
