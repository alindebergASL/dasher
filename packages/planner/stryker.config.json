{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": ["src/compile.ts", "src/plan.ts", "src/run.ts"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 58
  },
  "timeoutMS": 20000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "related": false
  },
  "inPlace": true,
  "ignoreStatic": true
}
