{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "ignoreStatic": true,
  "timeoutMS": 20000,
  "mutate": [
    "packages/dashboard-schema/src/compose.ts",
    "packages/dashboard-schema/src/layout.ts",
    "packages/ledger-domain/src/exact.ts",
    "packages/ledger-domain/src/ledger.ts",
    "packages/planner/src/compile-ledger.ts",
    "packages/planner/src/compile.ts",
    "packages/planner/src/freetext.ts",
    "packages/planner/src/ledger-plan.ts",
    "packages/planner/src/plan.ts",
    "packages/planner/src/provider.ts",
    "packages/planner/src/registry.ts",
    "packages/planner/src/run.ts",
    "packages/station-domain/src/facts.ts",
    "packages/station-domain/src/metrics.ts"
  ],
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.config.ts"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 73
  }
}
